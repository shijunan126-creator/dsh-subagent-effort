{
    "name":  "@shijunan123/dsh-client-ui-subagent-effort",
    "version":  "0.3.3",
    "description":  "GUI settings card for dsh-subagent-effort: choose the subagent model and reasoning effort in Settings 鈥?no config files to edit.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "license":  "MIT",
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "subagent",
                     "settings"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsdown"
                },
    "peerDependencies":  {
                             "react":  "^18.2.0"
                         },
    "devDependencies":  {
                            "@deepseek-ai/dsh-client-connection":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-locale":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-runtime":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-settings":  "^0.1.0-rc.6",
                            "@types/react":  "~18.3.1",
                            "lightningcss":  "1.32.0",
                            "react":  "^18.3.1",
                            "tsdown":  "0.22.2",
                            "typescript":  "~5.7.2"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime"
                                          ],
                               "platform":  "web"
                           }
            }
}
